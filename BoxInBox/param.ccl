# Parameter definitions for thorn BoxInBox

CCTK_INT num_regions "Number of refined regions"
{
  0:100 :: ""
} 0


################################################################################

# Box 1

KEYWORD shape_1 "Shape of refined region"
{
  "cube" :: "cube"
  "sphere" :: "sphere"
} "cube"



BOOLEAN active_1 "Is this region active?"
{
} "yes"



CCTK_INT num_levels_1 "Number of refinement levels for this centre"
{
  1:30 :: ""
} 1



CCTK_REAL position_x_1 "Position of this region"
{
  *:* :: ""
} 0.0

CCTK_REAL position_y_1 "Position of this region"
{
  *:* :: ""
} 0.0

CCTK_REAL position_z_1 "Position of this region"
{
  *:* :: ""
} 0.0



CCTK_REAL radius_1[30] "Radius of refined region for this level"
{
  -1 :: "illegal"
  (0:* :: ""
} -1.0

CCTK_REAL radius_x_1[30] "x-radius of refined region for this level"
{
  -1 :: "ignore this radius"
  (0:* :: ""
} -1.0

CCTK_REAL radius_y_1[30] "y-radius of refined region for this level"
{
  -1 :: "ignore this radius"
  (0:* :: ""
} -1.0

CCTK_REAL radius_z_1[30] "z-radius of refined region for this level"
{
  -1 :: "ignore this radius"
  (0:* :: ""
} -1.0


