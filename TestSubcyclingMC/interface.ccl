# Interface definition for thorn TestSubcyclingMC

IMPLEMENTS: TestSubcyclingMC

USES INCLUDE HEADER: loop_device.hxx
USES INCLUDE HEADER: subcycling.hxx
USES INCLUDE HEADER: subcycling_legacy.hxx
USES INCLUDE HEADER: vect.hxx



CCTK_REAL ustate TYPE=gf CENTERING={vvv} TAGS='dependents="uerror"'
{
  u
  rho
} "Scalar wave state vector"

CCTK_REAL cf_ownership_untagged TYPE=gf CENTERING={cvv} TAGS='checkpoint="no" evolve="yes" restrict="no"'
{
  cf_untagged
} "Untagged coarse-fine ownership test field"

CCTK_REAL cf_ownership_tagged TYPE=gf CENTERING={cvv} TAGS='checkpoint="no" evolve="yes" restrict="no" subcycling_prescribe_valid_cf_interface="yes"'
{
  cf_tagged
} "Tagged coarse-fine ownership test field"

CCTK_REAL pstate TYPE=gf TAGS='checkpoint="yes" evolve="no" restrict="no"'
{
  u_p
  rho_p
} "Scalar wave old state vector"

CCTK_REAL k1 TYPE=gf TAGS='checkpoint="yes" evolve="no" restrict="no"'
{
    u_k1
    rho_k1
} "The Runge-Kutta k_1 variables"

CCTK_REAL k2 TYPE=gf TAGS='checkpoint="yes" evolve="no" restrict="no"'
{
    u_k2
    rho_k2
} "The Runge-Kutta k_2 variables"

CCTK_REAL k3 TYPE=gf TAGS='checkpoint="yes" evolve="no" restrict="no"'
{
    u_k3
    rho_k3
} "The Runge-Kutta k_3 variables"

CCTK_REAL k4 TYPE=gf TAGS='checkpoint="yes" evolve="no" restrict="no"'
{
    u_k4
    rho_k4
} "The Runge-Kutta k_4 variables"



CCTK_REAL energy CENTERING={CCC} TYPE=gf TAGS='checkpoint="no"'
{
  eps
} "Energy density"



CCTK_REAL error TYPE=gf TAGS='checkpoint="no"'
{
  u_err
  rho_err
} "Error in scalar wave state vector"



