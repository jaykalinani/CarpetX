ActiveThorns = "
    CarpetX
    BoxInBox
    IOUtil
    TestSubcyclingMC
"

TestSubcyclingMC::initial_condition = "Gaussian"
TestSubcyclingMC::test_cf_ownership = yes

Cactus::cctk_itlast = 0
Cactus::presync_mode = "mixed-error"

CarpetX::use_subcycling = yes
CarpetX::restrict_during_sync = no
CarpetX::poison_undefined_values = no
CarpetX::verbose = no

CarpetX::xmin = -1.0
CarpetX::ymin = -1.0
CarpetX::zmin = -1.0
CarpetX::xmax = 1.0
CarpetX::ymax = 1.0
CarpetX::zmax = 1.0

CarpetX::ncells_x = 16
CarpetX::ncells_y = 16
CarpetX::ncells_z = 16

Driver::periodic = "yes"
Driver::periodic_x = yes
Driver::periodic_y = yes
Driver::periodic_z = yes

CarpetX::max_num_levels = 2
CarpetX::ghost_size = 3
CarpetX::prolongation_type = "ddf"
CarpetX::prolongation_order = 5

CarpetX::blocking_factor_x = 2
CarpetX::blocking_factor_y = 2
CarpetX::blocking_factor_z = 2
CarpetX::max_grid_size_x = 8
CarpetX::max_grid_size_y = 8
CarpetX::max_grid_size_z = 8
CarpetX::max_tile_size_x = 8
CarpetX::max_tile_size_y = 8
CarpetX::max_tile_size_z = 8

BoxInBox::num_regions = 1
BoxInBox::shape_1 = "cube"
BoxInBox::num_levels_1 = 2
BoxInBox::radius_1 = [ -1.0, 0.5 ]

IO::out_dir = $parfile
IO::out_every = 1
IO::parfile_write = no
IO::out_fileinfo = "axis labels"

CarpetX::out_adios2_every = 0
CarpetX::out_silo_every = 0
CarpetX::out_openpmd_every = 0
CarpetX::out_metadata = no
CarpetX::out_performance = no
CarpetX::out_norm_omit_unstable = yes
